# signal-scanner — all optional. Copy to .env and edit what you need.

# --- data backend ---
# 'yfinance' = free, no key (default). 'finnhub' = needs FINNHUB_API_KEY.
# SCAN_BACKEND=yfinance
# FINNHUB_API_KEY=

# --- files ---
# SCAN_WATCHLIST=./watchlist.txt
# SCAN_RULES=./rules.yaml

# --- indicator params (defaults are sensible) ---
# SCAN_RSI_PERIOD=14
# SCAN_SMA_FAST=20
# SCAN_SMA_SLOW=50
# SCAN_VOL_WINDOW=20
# SCAN_LOOKBACK_DAYS=260
# SCAN_INTERVAL_S=900

# --- optional Telegram delivery ---
# Create a bot via @BotFather, get the token; get your chat id from @userinfobot.
# Without these, alerts print to the console only.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
